# 8번 연습용

def get_digits(num): # 자릿수 구하기
    result = 0
    while num > 0:
        num //= 10
        result += 1
    return result

def reverse_num(num): # 숫자 뒤집기. 단, 마지막에 붙어 있는 0들은 제거됨. 
    result = 0
    while num > 0:
        result = result * 10 + num % 10 # 원래 있던 숫자들은 자릿수를 올림.
        num //= 10
    return result

