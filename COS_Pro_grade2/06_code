# 5번

def solution(money, price, n):

    result = money // price # 처음에 산 음료수
    empty = money // price # 그 갯수만큼 빈병이 생긴다.

    while empty >= n: # 빈병이 n 개 이상이 된다면
        result += 1
        empty -= n # n 개 교환하면서 빈병은 사라짐
        empty += 1 # 대신 빈병 1개 증가

    return result

