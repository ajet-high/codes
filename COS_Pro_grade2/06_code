# 6번 - 세 가지 방법으로 풀 수 있다.

# 첫번째 방법 (추천) : 대문자의 ascii 코드는 65 ~ 90 소문자는 97 ~ 122 숫자는 48 ~ 57 이라는 정보를 이용. 

def solution(password):
    big = 0
    small = 0
    digit = 0
    
    for p in password:
        if 65 <= ord(p) <= 90: big += 1 # ord( ) 속에 문자를 넣으면 ascii 값(숫자)를 반환(return)
        elif 97 <= ord(p) <= 122: small += 1
        elif 48 <= ord(p) <= 57: digit += 1


    if big >= 1 and small >= 2 and digit >= 2: return True
    return False

# 두번째 방법 : 문자열의 대소 비교를 이용.

def solution(password):
    big = 0
    small = 0
    digit = 0
    
    for p in password:
        if 'A' <= p <= 'Z': big += 1 # ord( ) 속에 문자를 넣으면 ascii 값(숫자)를 반환(return)
        elif 'a' <= p <= 'z': small += 1
        elif '0' <= p <= '9': digit += 1


    if big >= 1 and small >= 2 and digit >= 2: return True
    return False


# 세번째 방법 : 대소문자, 숫자 판별 내장함수 사용

def solution(password):
    big = 0
    small = 0
    digit = 0
    
    for p in password:
        if p.isupper(): big += 1 # ord( ) 속에 문자를 넣으면 ascii 값(숫자)를 반환(return)
        elif p.islower(): small += 1
        elif p.isdigit(): digit += 1


    if big >= 1 and small >= 2 and digit >= 2: return True
    return False


print(solution("helloworld"))
print(solution("Hello123"))



