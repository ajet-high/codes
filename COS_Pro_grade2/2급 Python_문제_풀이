def solution(n, m, area, c):

    board = [[0 for j in range(n)] for i in range(n)]

    for k in range(m):
        left_up_row = area[k][0]
        left_up_col = area[k][1]
        right_dn_row = area[k][2]
        right_dn_col = area[k][3]
        cur_col = area[k][4]
        
        for i in range(left_up_row, right_dn_row + 1):
            for j in range(left_up_col, right_dn_col + 1):
                if board[i][j] == 0:
                    board[i][j] = cur_col
                elif board[i][j] != cur_col:
                    board[i][j] = 3

    result = 0
    for i in range(n):
        for j in range(n):
            if board[i][j] == c:
                result += 1

    return result

