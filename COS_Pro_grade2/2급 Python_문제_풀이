def get_gcd(num1, num2):
    for i in range(min(num1, num2), 0, -1):
        if num1 % i == 0 and num2 % i == 0:
            return i

def get_gcd2(num1, num2):
    if num2 == 0:
        return num1
    return get_gcd2(num2, num1 % num2)
    

def solution(arr, n):
    result = 0
    
    for i in range(n):
        a, b = arr[i]
        result = max(result, get_gcd(a, b))

    return result

