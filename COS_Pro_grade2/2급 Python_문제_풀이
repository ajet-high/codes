def solution(arr, n):
    choice = [0 for i in range(101)]

    for i in range(n):
        choice[arr[i]] += 1

    max_cnt = 0
    max_num = 0

    for i in range(1, 101):
        if choice[i] >= max_cnt:
            max_cnt = choice[i]
            max_num = i

    return max_num

