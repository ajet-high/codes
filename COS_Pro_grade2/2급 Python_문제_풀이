# 4번
def solution(arr, n, m):

    part_sum = sum(arr[:m])
    # n 개의 숫자 중에 m 개를 선택한다면
    # 마지막으로 m 개를 선택할 상황은
    # (n - m개)(m 개)

    max_sum = min_sum = part_sum

    for i in range(1, n - m + 1): # m 개를 시작하는 인덱스의 위치가 i
        part_sum -= arr[i - 1]
        part_sum += arr[i + m - 1]

        max_sum = max(max_sum, part_sum)
        min_sum = min(min_sum, part_sum)

    return max_sum - min_sum

