nums = [[1, 0, 2, 1, 0],
        [1, 0, 0, 1, 0],
        [1, 2, 0, 1, 1],
        [0, 0, 1, 1, 3],
        [1, 4, 1, 1, 0],
        [1, 0, 3, 1, 3]]

# 그대로 행 열 맞춰서 출력
for i in range(len(nums)):
    for j in range(len(nums[i])):
        print(nums[i][j], end = ' ')
    print()

# 1의 갯수 세기
cnt = 0
for i in range(len(nums)):
    for j in range(len(nums[i])):
        if nums[i][j] == 1:
            cnt = cnt + 1
print("1의 갯수는", cnt)

# 줄마다 거꾸로 출력
for i in range(len(nums)):
    for j in range(len(nums[i]) - 1, -1, -1):
        print(nums[i][j], end = ' ')
    print()

# 모든 수의 합
sum = 0
for i in range(len(nums)):
    for j in range(len(nums[i])):
        sum = sum + nums[i][j]
print(sum)
        

# 각 숫자별 갯수 구하기
cnt = [0, 0, 0, 0, 0]
for i in range(len(nums)):
    for j in range(len(nums[i])):
        cnt[nums[i][j]] = cnt[nums[i][j]] + 1 
print(cnt[1], cnt[2], cnt[3]) # 1, 2, 3의 갯수

# 모든 숫자별 갯수
for i in range(len(cnt)):
    print(i, "는", cnt[i], "개 있습니다")      
